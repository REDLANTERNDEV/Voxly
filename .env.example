# Copy this file to `.env` in the repository root before using Docker Compose.
# Keep `.env` private. Do not commit real secrets, domain values, or VPS IPs.

# Public web URL used when the owner CLI prints claim links.
# Local Docker default: http://127.0.0.1:3000
# Production example: https://chat.example.com
VOXLY_PUBLIC_URL=http://127.0.0.1:3000

# Optional override. Leave unset for auto:
# - https VOXLY_PUBLIC_URL => secure cookies
# - http VOXLY_PUBLIC_URL => non-secure cookies for local testing
# COOKIE_SECURE=false

# Docker Compose binds the Node app to 127.0.0.1:${VOXLY_HTTP_PORT}.
# Your existing Nginx reverse proxy should be the public HTTPS entry point.
VOXLY_HTTP_PORT=3000

# Existing external Docker network to join, for compose.external-proxy.yaml only.
# Ignored by compose.yaml. Dokploy uses dokploy-network; Coolify uses coolify.
# PROXY_NETWORK=dokploy-network

# Rate limits identify clients by X-Forwarded-For, because every supported
# deployment puts a reverse proxy in front. Set this to false ONLY if the app
# port is reachable directly from the internet, where the header can be forged.
# TRUST_PROXY=true

# Conservative defaults for a small self-hosted server.
VOXLY_APP_MEMORY_LIMIT=384m
VOXLY_APP_MEMORY_RESERVATION=160m

# Production owner setup should use:
# docker compose exec app npm run owner:create -w @voxly/server -- --nickname "Owner"
ENABLE_HTTP_OWNER_BOOTSTRAP=false

# Only set this for temporary local/dev HTTP bootstrap, together with
# ENABLE_HTTP_OWNER_BOOTSTRAP=true. Do not use it in production.
# OWNER_BOOTSTRAP_TOKEN=replace-with-long-random-token

# Optional Cloudflare Turnstile keys. Leave both blank when Turnstile is disabled.
# Site key is public and is sent to the browser by /api/config. Secret stays server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional landing-page analytics. Leave all three blank to disable: a default
# deployment loads no analytics script and contacts no analytics host. When set,
# the script is loaded only on the public landing page ("/"); authenticated app
# routes are never reported, and the values below are sent to the browser by
# /api/config.
#
# ANALYTICS_PROVIDER=umami
#   ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
#   ANALYTICS_WEBSITE_ID=<website id from your Umami instance>
# ANALYTICS_PROVIDER=google
#   ANALYTICS_WEBSITE_ID=G-XXXXXXXXXX   (ANALYTICS_SCRIPT_URL is not used)
ANALYTICS_PROVIDER=
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=

# Optional Coturn fallback. Keep all values blank unless Coturn is intentionally
# deployed. TURN credentials are issued only by the authenticated RTC endpoint.
# The TURN hostname must be a DNS-only record and the secret must be at least
# 32 random bytes. TURN_CERT_DIR must contain live/<TURN_REALM>/fullchain.pem
# and privkey.pem. For root-only ACME files, use infra/export-turn-cert.sh and
# set this to its private export directory (default: /opt/voxly/secrets/turn).
TURN_REALM=
TURN_STATIC_AUTH_SECRET=
TURN_EXTERNAL_IP=
TURN_CERT_DIR=/opt/voxly/secrets/turn
TURN_CREDENTIAL_TTL_SECONDS=86400
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=40
VOXLY_TURN_MEMORY_LIMIT=128m
VOXLY_TURN_MEMORY_RESERVATION=32m
