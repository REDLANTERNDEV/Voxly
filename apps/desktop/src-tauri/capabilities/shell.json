{
  "identifier": "local-shell",
  "description": "Only the bundled installation chooser may manage the native shell.",
  "local": true,
  "windows": [
    "shell"
  ],
  "webviews": [
    "shell"
  ],
  "permissions": [
    "allow-shell-state",
    "allow-take-desktop-link",
    "allow-transition-state",
    "allow-save-installation",
    "allow-forget-installation",
    "allow-connect-installation",
    "allow-cancel-connection",
    "allow-disconnect-installation",
    "allow-open-installation-browser",
    "allow-set-language",
    "allow-acknowledge-tray",
    "allow-shell-update-state",
    "allow-take-tray-update-check",
    "allow-check-shell-update",
    "allow-download-shell-update",
    "allow-cancel-shell-update",
    "allow-install-shell-update",
    "allow-quit-app",
    "allow-set-mute-shortcut",
    "allow-set-deafen-shortcut",
    "allow-set-push-to-talk-shortcut",
    "allow-set-push-to-mute-shortcut",
    "allow-set-microphone-mode",
    "allow-set-push-to-talk-release-delay",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-settings"
  ]
}
