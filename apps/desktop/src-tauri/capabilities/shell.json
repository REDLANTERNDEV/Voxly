{
  "identifier": "local-shell",
  "description": "Only the bundled installation chooser may manage the native shell.",
  "local": true,
  "windows": ["shell"],
  "webviews": ["shell"],
  "permissions": [
    "allow-shell-state", "allow-save-installation", "allow-forget-installation",
    "allow-connect-installation", "allow-disconnect-installation",
    "allow-open-installation-browser", "allow-set-language", "allow-acknowledge-tray",
    "allow-quit-app", "allow-set-mute-shortcut", "allow-set-deafen-shortcut", "allow-set-push-to-talk-shortcut", "allow-set-push-to-mute-shortcut", "allow-set-microphone-mode", "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
